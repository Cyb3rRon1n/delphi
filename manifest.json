{
  "manifest_version": 3,
  "name": "Delphi — Study Explainer",
  "version": "0.4.0",
  "description": "Select, screenshot, or auto-detect questions on any page and get explanation-first answers from a local LLM. Manual trigger for every answer — auto-detect adds click-to-explain buttons (or one 'explain all' for a whole page of questions), per-tab, opt-in.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": { "id": "delphi@cyb3rron1n.dev", "strict_min_version": "121.0" }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Explain the selected question"
    },
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
      "description": "Capture a screen region to explain"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/lib/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
